# Configuración para correr TODO en contenedores:
#   docker compose --env-file .env.production --profile app up -d --build
# Copia este archivo a .env.production (no se sube al repositorio) y cambia los secretos.
# Secretos aleatorios de al menos 32 caracteres y distintos entre sí. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Dirección desde la que se abre la web (con https en producción; http://localhost:8080 para probar en tu equipo)
CORS_ORIGIN=http://localhost:8080
EXPORT_CITY=Neiva

# Cuentas que crea `npm run users:bootstrap` (contraseñas de mínimo 12 caracteres, distintas a las de desarrollo)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SAVITRA_NAME=
SAVITRA_EMAIL=
SAVITRA_PASSWORD=
