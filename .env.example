# Copia a .env y ajusta. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=4000
# MongoDB de Docker (npm run db:up) en el puerto 27018. Para otro MongoDB, cambia esta URI.
MONGO_URI=mongodb://127.0.0.1:27018/turnos?replicaSet=rs0&directConnection=true
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-32-caracteres-o-mas
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-distinto-al-anterior
# Origen(es) de la web permitidos por CORS, separados por coma. En desarrollo la web usa el proxy de Vite y no lo necesita.
CORS_ORIGIN=http://localhost:5173
# Cuántos proxies hay delante de la API (0 en desarrollo; 1 con Nginx). Sin esto, detrás de un proxy el límite por IP bloquea a todos a la vez.
TRUST_PROXY=0
# fatal | error | warn | info | debug | silent
LOG_LEVEL=info
# Días que se conservan los registros de auditoría; luego MongoDB los borra solo. 0 = no se borran nunca.
# El plazo lo define el hospital con su área jurídica (Ley 1581 de 2012).
AUDIT_RETENTION_DAYS=0
# Ciudad del encabezado de los archivos exportados ("NEIVA, SEPTIEMBRE 2026")
EXPORT_CITY=Neiva

# Cuentas que crea `npm run users:bootstrap` (no se muestran en el login; contraseñas de mínimo 12 caracteres)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SAVITRA_NAME=
SAVITRA_EMAIL=
SAVITRA_PASSWORD=
