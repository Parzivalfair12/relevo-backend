{
  "name": "turnos-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "tsx --env-file=.env src/seed/index.ts",
    "perf": "tsx --env-file=.env scripts/perf.ts",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "backup": "node scripts/backup.mjs backup",
    "backup:verify": "node scripts/backup.mjs verify",
    "restore": "node scripts/backup.mjs restore",
    "engine:hash": "node scripts/engine-hash.mjs",
    "engine:check": "node scripts/engine-hash.mjs --check",
    "golden:update": "tsx scripts/update-golden.ts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "mongoose": "^8.7.0",
    "pino": "^9.4.0",
    "tsx": "^4.19.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
